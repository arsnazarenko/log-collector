# Build stage
FROM golang:1.25.6-alpine AS build-stage

RUN apk add --no-cache git

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -a -o collector ./cmd/collector

# Final stage - minimal image
FROM alpine:3.22.3

WORKDIR /app

COPY --from=build-stage /app/collector /collector

EXPOSE 8080

ENTRYPOINT ["/collector"]
